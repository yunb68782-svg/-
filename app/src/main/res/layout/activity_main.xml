<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_main"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_title"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvCurrentWallpaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_wallpaper_selected"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 应用与导入 -->
        <Button
            android:id="@+id/btnApplyWallpaper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_apply_wallpaper"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnPickVideo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            style="@style/Widget.Material3.Button.TonalButton"
            android:text="@string/btn_pick_video"
            android:textSize="15sp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            android:layout_marginBottom="16dp" />

        <!-- 自由调节面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎛️ 画面自由调节 (想怎么调怎么调)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/accent_gold" />

            <!-- 缩放控制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 自由缩放 (50% ~ 300%)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvScaleValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/sbScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="250"
                android:progress="50"
                android:layout_marginTop="6dp" />

            <!-- 水平左右平移 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↔️ 水平左右平移"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvOffsetXValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="居中 (0)"
                    android:textColor="@color/accent_cyan" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/sbOffsetX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:layout_marginTop="6dp" />

            <!-- 垂直上下平移 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↕️ 垂直上下平移"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvOffsetYValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="居中 (0)"
                    android:textColor="@color/accent_cyan" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/sbOffsetY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:layout_marginTop="6dp" />

            <!-- 旋转与重置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <Button
                    android:id="@+id/btnRotate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="🔄 旋转 90°"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/btnResetTransform"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="⚡ 一键居中" />
            </LinearLayout>
        </LinearLayout>

        <!-- 120FPS 内置极客母带 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 100MB+ 满血 120FPS 极客母带"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="原生 120 帧渲染，搭配高刷屏体验极致丝滑"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">
                <Button
                    android:id="@+id/btnPreset1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:text="赛博矩阵 120F"
                    android:layout_margin="3dp" />
                <Button
                    android:id="@+id/btnPreset2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:text="霓虹几何 120F"
                    android:layout_margin="3dp" />
                <Button
                    android:id="@+id/btnPreset3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:text="量子核心 120F"
                    android:layout_margin="3dp" />
                <Button
                    android:id="@+id/btnPreset4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:text="深空视界 120F"
                    android:layout_margin="3dp" />
            </GridLayout>
        </LinearLayout>

        <!-- 声音设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="桌面声音开关"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认静音，双击桌面可随时开关"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tip_power_save"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
